<!-- Add this to your HTML <head> section -->
<!-- Multiple favicon formats for cross-browser support -->
<link rel="icon" type="image/x-icon" href="/favicon.ico">
<link rel="icon" type="image/png" href="/favicon.png" sizes="32x32">
<link rel="icon" type="image/png" href="/favicon.png" sizes="16x16">
<link rel="apple-touch-icon" href="/favicon.png">

<!-- If you want to use a data URI (no file needed) -->
<link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect fill='%23FF1493' width='100' height='100'/><text x='50' y='65' font-size='60' text-anchor='middle' fill='white' font-weight='bold'>✊</text></svg>">
